[{"headline": "\u0418\u0440\u0430\u043d \u00ab\u0440\u0435\u0448\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043e\u0441\u0443\u0434\u0438\u043b\u00bb \u0430\u0442\u0430\u043a\u0443 \u0423\u043a\u0440\u0430\u0438\u043d\u044b \u043d\u0430 \u0438\u0440\u0430\u043d\u0441\u043a\u043e\u0435 \u0441\u0443\u0434\u043d\u043e \u0432 \u041a\u0430\u0441\u043f\u0438\u0439\u0441\u043a\u043e\u043c \u043c\u043e\u0440\u0435  \u0412 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0435 \u0430\u0442\u0430\u043a\u0438 \u043e\u0434\u0438\u043d \u043c\u043e\u0440\u044f\u043a \u043f\u043e\u0433\u0438\u0431, \u0435\u0449\u0435 \u043e\u0434\u0438\u043d \u0431\u044b\u043b \u0440\u0430\u043d\u0435\u043d.   \u00ab\u042d\u0442\u043e\u0442 \u0430\u043a\u0442 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0433\u0440\u0443\u0431\u044b\u043c \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435\u043c \u043f\u0443\u043d\u043a\u0442\u0430 4 \u0441\u0442\u0430\u0442\u044c\u0438 2 \u0423\u0441\u0442\u0430\u0432\u0430 \u041e\u041e\u041d", "summary": "\u0418\u0440\u0430\u043d \u00ab\u0440\u0435\u0448\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043e\u0441\u0443\u0434\u0438\u043b\u00bb \u0430\u0442\u0430\u043a\u0443 \u0423\u043a\u0440\u0430\u0438\u043d\u044b \u043d\u0430 \u0438\u0440\u0430\u043d\u0441\u043a\u043e\u0435 \u0441\u0443\u0434\u043d\u043e \u0432 \u041a\u0430\u0441\u043f\u0438\u0439\u0441\u043a\u043e\u043c \u043c\u043e\u0440\u0435 \u0412 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0435 \u0430\u0442\u0430\u043a\u0438 \u043e\u0434\u0438\u043d \u043c\u043e\u0440\u044f\u043a \u043f\u043e\u0433\u0438\u0431, \u0435\u0449\u0435 \u043e\u0434\u0438\u043d \u0431\u044b\u043b \u0440\u0430\u043d\u0435\u043d. \u00ab\u042d\u0442\u043e\u0442 \u0430\u043a\u0442 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0433\u0440\u0443\u0431\u044b\u043c \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0435\u043c \u043f\u0443\u043d\u043a\u0442\u0430 4 \u0441\u0442\u0430\u0442\u044c\u0438 2 \u0423\u0441\u0442\u0430\u0432\u0430 \u041e\u041e\u041d \u0438 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0430\u043a\u0442\u043e\u043c \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043c\u043e\u0436\u0435\u0442 \u0435\u0449\u0435 \u0431\u043e\u043b\u044c\u0448\u0435 \u0440\u0430\u0437\u0436\u0435\u0447\u044c\u2026"}, {"headline": "\u0412 \u0411\u0435\u0440\u043b\u0438\u043d\u0435 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044c \u0432\u044a\u0435\u0445\u0430\u043b \u0432 \u0442\u043e\u043b\u043f\u0443 \u043b\u044e\u0434\u0435\u0439, \u043e\u0434\u0438\u043d \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u043f\u043e\u0433\u0438\u0431  \u0415\u0449\u0435 16 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u043f\u043e\u0441\u0442\u0440\u0430\u0434\u0430\u043b\u0438, \u0442\u0440\u043e\u0435 \u0438\u0437 \u043d\u0438\u0445 \u043d\u0430\u0445\u043e\u0434\u044f\u0442\u0441\u044f \u0432 \u0442\u044f\u0436\u0435\u043b\u043e\u043c \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0438, \u0441\u043e\u043e\u0431\u0449\u0430\u0435\u0442 Bild.  \u0410\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044c \u043d\u0430\u0435\u0445\u0430\u043b \u043d\u0430 \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u043e\u0432 \u041b\u0413\u0411\u0422-\u043f\u0440\u0430\u0439\u0434\u0430 \u0432 \u0440\u0430\u0439\u043e\u043d", "summary": "\u0412 \u0411\u0435\u0440\u043b\u0438\u043d\u0435 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044c \u0432\u044a\u0435\u0445\u0430\u043b \u0432 \u0442\u043e\u043b\u043f\u0443 \u043b\u044e\u0434\u0435\u0439, \u043e\u0434\u0438\u043d \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u043f\u043e\u0433\u0438\u0431 \u0415\u0449\u0435 16 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u043f\u043e\u0441\u0442\u0440\u0430\u0434\u0430\u043b\u0438, \u0442\u0440\u043e\u0435 \u0438\u0437 \u043d\u0438\u0445 \u043d\u0430\u0445\u043e\u0434\u044f\u0442\u0441\u044f \u0432 \u0442\u044f\u0436\u0435\u043b\u043e\u043c \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0438, \u0441\u043e\u043e\u0431\u0449\u0430\u0435\u0442 Bild. \u0410\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044c \u043d\u0430\u0435\u0445\u0430\u043b \u043d\u0430 \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u043e\u0432 \u041b\u0413\u0411\u0422-\u043f\u0440\u0430\u0439\u0434\u0430 \u0432 \u0440\u0430\u0439\u043e\u043d\u0435 \u0422\u0438\u0440\u0433\u0430\u0440\u0442\u0435\u043d, \u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044e \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0441\u043a\u0440\u044b\u0442\u044c\u0441\u044f. \u041f\u043e \u043f\u043e\u0434\u043e\u0437\u0440\u0435\u043d\u0438\u044e \u0432\u2026"}, {"headline": "\u0422\u0440\u043e\u0435 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0445 \u0434\u0435\u0442\u0435\u0439 \u043f\u043e\u0433\u0438\u0431\u043b\u0438 \u043f\u043e\u0441\u043b\u0435 \u043e\u0442\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0433\u0430\u0437\u043e\u043c \u0432 \u041c\u0430\u0445\u0430\u0447\u043a\u0430\u043b\u0435.", "summary": "\u0422\u0440\u043e\u0435 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0445 \u0434\u0435\u0442\u0435\u0439 \u043f\u043e\u0433\u0438\u0431\u043b\u0438 \u043f\u043e\u0441\u043b\u0435 \u043e\u0442\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0433\u0430\u0437\u043e\u043c \u0432 \u041c\u0430\u0445\u0430\u0447\u043a\u0430\u043b\u0435. \u0422\u0440\u0430\u0433\u0435\u0434\u0438\u044f \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u0430 \u0432\u0435\u0447\u0435\u0440\u043e\u043c 25 \u0438\u044e\u043b\u044f \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u043c \u0434\u043e\u043c\u0435 \u043d\u0430 \u0443\u043b\u0438\u0446\u0435 \u0411\u0443\u0433\u043b\u0435\u043d\u0441\u043a\u043e\u0439. \u041e\u0441\u0442\u0430\u0432\u0448\u0438\u0441\u044c \u0431\u0435\u0437 \u043f\u0440\u0438\u0441\u043c\u043e\u0442\u0440\u0430 \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445, \u0434\u0435\u0442\u0438 \u043e\u0442\u043a\u0440\u044b\u043b\u0438 \u0433\u0430\u0437\u043e\u0432\u044b\u0439 \u043a\u0440\u0430\u043d, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0430\u0445\u043e\u0434\u0438\u043b\u0441\u044f \u0432 \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u043c \u0434\u043e\u0441\u0442\u0443\u043f\u0435. \u0416\u0438\u043b\u043e\u0435 \u043f\u043e\u043c\u0435\u0449\u0435\u043d\u0438\u0435 \u0431\u044b\u0441\u0442\u0440\u043e \u0437\u0430\u043f\u043e\u043b\u043d\u0438\u043b\u043e\u0441\u044c \u0433\u0430\u0437\u043e\u043c, \u0438 \u0432\u0441\u0435 \u0442\u0440\u043e\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0438 \u0441\u043c\u0435\u0440\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u043e\u0442\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435. \u0412 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0438 \u0445\u043e\u0437\u044f\u0438\u043d\u0430 \u0434\u043e\u043c\u0430 \u0432\u043e\u0437\u0431\u0443\u0436\u0434\u0435\u043d\u043e \u0443\u0433\u043e\u043b\u043e\u0432\u043d\u043e\u0435 \u0434\u0435\u043b\u043e \u043e \u043f\u0440\u0438\u0447\u0438\u043d\u0435\u043d\u0438\u0438 \u0441\u043c\u0435\u0440\u0442\u0438 \u043f\u043e \u043d\u0435\u043e\u0441\u0442\u043e\u0440\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0434\u0432\u0443\u043c \u0438 \u0431\u043e\u043b\u0435\u0435 \u043b\u0438\u0446\u0430\u043c. \u2b50\ufe0f \u0413\u043b\u0430\u0432\u043d\u044b\u0435 \u043f\u0440\u043e\u0438\u0441\u0448\u0435\u0441\u0442\u0432\u0438\u044f \u2014 112"}]